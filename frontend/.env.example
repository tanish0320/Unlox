# Use the built-in fake backend when true.
VITE_USE_MOCK=true
# Local API route; Vite proxies it to the backend during development.
VITE_API_BASE=/api
# Delay between job status checks in milliseconds.
VITE_POLL_INTERVAL_MS=500
# Maximum time to wait for a job in milliseconds.
VITE_JOB_TIMEOUT_MS=60000
